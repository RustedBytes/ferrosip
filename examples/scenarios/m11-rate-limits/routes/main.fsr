// Rate limits per source and for new calls; in-dialog traffic is exempt.
import ip, limits, pipe_limits, route_set, text
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    // Established calls must always be able to end: no limits in a dialog,
    // nor for CANCEL (it ends a call that is being set up).
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    // At most 5 requests per 2s from one source. The key is ip:port: phones
    // behind one NAT share the address but not the port.
    if !pipe_limits.check_or_create("src:{msg.src.ip}:{msg.src.port}", "TAILDROP", 5) {
        pipe_limits.reject(2s)
    }
    // At most 4 new calls per 2s in all (the queue "calls:INVITE").
    if msg.method == INVITE && !limits.check_rate() {
        text.append_to_reply("Retry-After: 2\r\n")
        reply(ServiceUnavailable, "Too many calls")
    }
    if msg.method == INVITE {
        route_set.record()
    }
    msg.dst_uri = features.upstream
    relay(msg)
}
