// A registrar on the shared location table: authenticate, save, look up.
import auth, location, route_set
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    guard auth.check(features.realm) else auth.challenge(features.realm)
    auth.consume_credentials()
    if msg.method == REGISTER {
        location.save()
    }
    guard location.lookup() else reply(NotFound, "Not registered")
    route_set.record()
    msg.headers["X-Served-By"] = features.name
    relay(msg)
}
