// Calls to registered users, with voicemail on busy, no answer and
// not registered.
import auth, ip, location, route_set, text
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    if msg.method == REGISTER {
        guard auth.check(features.realm) else auth.challenge(features.realm)
        location.save()
    }
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    if msg.method != INVITE {
        reply(MethodNotAllowed)
    }
    route_set.record()
    let mailbox = msg.ruri.user
    guard location.lookup() else voicemail(msg, mailbox, "unavailable")
    let res = await txn.relay(msg, timeout: 5s)
    match res {
        // Canceled by the caller, or a 6xx (global: RFC 3261 §16.7): no
        // voicemail.
        Final(r) if txn.is_canceled() || r.code >= 600 => forward(r)
        // drop_replies: bob's 486 must not be what the caller gets if they
        // hang up while the mailbox rings (that's a 487).
        Final(r) if r.code == BusyHere => {
            txn.drop_replies()
            voicemail(msg, mailbox, "user-busy")
        }
        Timeout => {
            txn.drop_replies()
            voicemail(msg, mailbox, "no-answer")
        }
        // Answered (already forwarded), a redirect (forwarded: see the
        // README), or any other failure.
        Final(r) => forward(r)
    }
}

// The same transaction, retargeted to the mailbox; Diversion (RFC 5806)
// tells the voicemail server whose mailbox and why.
fn voicemail(msg: Request, mailbox: Str, why: Str) -> Action {
    msg.ruri = "sip:{mailbox}@{features.voicemail_domain}"
    msg.dst_uri = features.voicemail
    text.append_header("Diversion: <sip:{mailbox}@{features.realm}>;reason={why}\r\n")
    relay(msg)
}
