// Edge proxy: protects the core, keeps itself in every dialog.
import sip, route_set, path
import { features } from config

shared table hits: Map<Str, Counter> ttl 1s
shared table banned: Map<Str, Bool> ttl 30s

// The edge forwards only to the core, which authenticates every request.
// lint: allow(open_relay)
route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    // Flood protection per source address (ip:port: phones behind one NAT
    // aren't punished together).
    let who = "{msg.src.ip}:{msg.src.port}"
    guard !banned.contains(who) else drop
    if hits.incr(who) > features.flood_limit {
        banned.set(who, true)
        log.warn("banned {who}\n")
        drop
    }
    if msg.method == OPTIONS && sip.options_reply() {
        exit
    }
    // In-dialog, or a request the core sends towards a phone (its Route is
    // the Path we added at registration).
    if route_set.follow() {
        if !msg.has_to_tag {
            route_set.record()
        }
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    if msg.method == REGISTER {
        path.add()
    } else {
        route_set.record()
    }
    msg.dst_uri = features.core
    relay(msg)
}
