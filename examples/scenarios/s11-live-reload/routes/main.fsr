// A relay to one upstream that says which routing (X-Routing) and which
// configuration (X-Release) handled each request.
import ip, route_set, text
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    text.append_header("X-Routing: v1\r\n")
    text.append_header("X-Release: {features.release}\r\n")
    msg.dst_uri = features.upstream
    if msg.method != INVITE {
        relay(msg)
    }
    route_set.record()
    let res = await txn.relay(msg, timeout: 60s)
    match res {
        Final(r) if r.code == BusyHere => reply(BusyHere, "Busy v1")
        Final(r) => forward(r)
        Timeout => reply(RequestTimeout)
    }
}
