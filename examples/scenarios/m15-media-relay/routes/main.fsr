// Calls through a media relay: offer on the INVITE, answer on the reply,
// delete on BYE and when the call fails.
import media, ip, route_set
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        if msg.method == BYE {
            media.delete()
        } else if msg.method == INVITE && msg.has_sdp {
            // A re-INVITE (hold, resume, new ports): a new offer, same session.
            guard media.offer(features.media_flags) else reply(ServerInternalError, "Media relay failed")
        }
        relay(msg)
    }
    if msg.method == CANCEL {
        // The INVITE's await below sees the 487 and deletes the session.
        relay(msg)
    }
    if msg.method != INVITE {
        reply(MethodNotAllowed)
    }
    route_set.record()
    if msg.has_sdp {
        guard media.offer(features.media_flags) else reply(ServerInternalError, "Media relay failed")
    }
    let res = await txn.relay(msg, timeout: 20s)
    match res {
        Final(r) if r.code in 200..299 => {}
        // Busy, rejected, canceled or no answer: the relay can let go now.
        _ => media.delete()
    }
}

// The answer (a 183 with early media, or the 200) goes through the relay too.
on reply(r: Reply) where r.has_sdp && r.code in 180..299 {
    media.answer(features.media_flags)
}
