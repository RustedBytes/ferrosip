// Border proxy with topology hiding: calls from inside go to the carrier.
import ip, route_set
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    // In-dialog, either way: our Record-Route, then the R-URI, which topoh
    // has turned back from the masked Contact into the real one.
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    guard ip.in_subnet(msg.src.ip, features.internal) else reply(Forbidden, "Not trusted")
    route_set.record()
    msg.dst_uri = features.carrier
    relay(msg)
}
