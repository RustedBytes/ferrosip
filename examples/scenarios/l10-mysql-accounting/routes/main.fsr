// Accounting: answered and missed INVITEs to the database (acc), and a
// CDR when a call ends (acc + dialog).
import dialog, ip, route_set
import { features } from config

// acc selects transactions by flag number: these must stay the first two
// flags (bits 31 and 30, db_flag and db_missed_flag in ferrosip.toml).
flag ACC
flag ACC_MISSED

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    if msg.has_to_tag {
        // BYE and re-INVITE follow the Record-Route; the dialog module
        // matches them (also to a dialog loaded from the table).
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    guard msg.method == INVITE else reply(MethodNotAllowed)
    dialog.manage()
    msg.set(ACC)
    msg.set(ACC_MISSED)
    route_set.record()
    msg.dst_uri = features.callee
    relay(msg)
}
