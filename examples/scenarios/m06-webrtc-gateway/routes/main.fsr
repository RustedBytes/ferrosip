// WebRTC gateway: SIP over WebSocket on one side, UDP on the other.
import auth, location, nat, route_set
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        // Towards a browser the R-URI is its Contact (an .invalid host);
        // the ;alias we added says which connection it is.
        nat.handle_ruri_alias()
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    guard auth.check(features.realm) else auth.challenge(features.realm)
    auth.consume_credentials()
    if msg.method == REGISTER {
        // The registrar keeps the WebSocket connection with the binding.
        location.save()
    }
    // A browser's Contact can't be reached by name: add where it is.
    if msg.src.transport == WS || msg.src.transport == WSS {
        nat.add_contact_alias()
    }
    // Two Record-Routes when the call changes transport (enable_double_rr).
    route_set.record()
    guard location.lookup() else reply(NotFound, "Not registered")
    relay(msg)
}

// The same for a browser's answer.
on reply(r: Reply) where r.src.transport == WS || r.src.transport == WSS {
    nat.add_contact_alias()
}
