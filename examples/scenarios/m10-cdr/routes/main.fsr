// CDRs from dialogs, POSTed to a collector.
import dialog, http_client, ip, route_set
import { features } from config

dialog var caller: Str
dialog var plan: Str

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    if msg.method != INVITE {
        reply(MethodNotAllowed)
    }
    dialog.manage()
    dialog.caller = msg.from.user
    dialog.plan = "postpaid"
    // Prepaid callers (pp…): the call is cut after 3s, BYE to both sides.
    if msg.from.user =~ "^pp" {
        dialog.plan = "prepaid"
        dialog.set_timeout(3s)
        dialog.set_property("timeout-bye")
    }
    route_set.record()
    msg.dst_uri = features.callee
    relay(msg)
}

// Handlers can't await: http_client blocks the worker for up to
// connection_timeout (1s) when the collector is slow or down. `query`, not
// `post`: post sends no Content-Type.
fn post_cdr(body: Str) {
    let answer = ""
    if !http_client.query("{features.collector}/cdr", body, "Content-Type: application/json", answer) {
        log.error("cdr not stored: {body}\n")
    }
}

on dialog.ended(d: Dialog) {
    log.info("cdr {d.call_id} {d.caller} {d.duration}s {d.end_reason}\n")
    post_cdr("\{\"call_id\":\"{d.call_id}\",\"caller\":\"{d.caller}\",\"plan\":\"{d.plan}\",\"from\":\"{d.from_uri}\",\"to\":\"{d.to_uri}\",\"start\":{d.started_at},\"duration\":{d.duration},\"end_reason\":\"{d.end_reason}\"\}")
}

on dialog.failed(d: Dialog) {
    post_cdr("\{\"call_id\":\"{d.call_id}\",\"caller\":\"{d.caller}\",\"plan\":\"{d.plan}\",\"code\":{d.code},\"end_reason\":\"failed\"\}")
}

// Requests the proxy makes itself (the BYEs that end a prepaid call or an
// admin's dlg.end_dlg) say so: tm runs this before it sends each of them,
// and not for the BYEs it relays. `.fsr` has no typed form of it, so it is
// the Kamailio event route.
on kamailio.event_route(name: "tm:local-request") {
    if pv("$rm") == "BYE" {
        kamailio.call("append_hdr", "Reason: SIP;cause=200;text=\"Call ended by the proxy\"\r\n")
    }
}
