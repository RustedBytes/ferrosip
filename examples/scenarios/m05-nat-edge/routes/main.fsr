// Registrar and proxy for phones behind NAT.
import auth, location, nat, route_set
import { features } from config

flag NATED

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    // Behind NAT: a private Contact (1), a Via address (2) or port (16)
    // that isn't where the packet came from.
    if nat.is_behind(19) {
        msg.set(NATED)
    }
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        // A re-INVITE or UPDATE may bring a new (private) Contact.
        if msg.is(NATED) {
            nat.fix_contact()
        }
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    guard auth.check(features.realm) else auth.challenge(features.realm)
    auth.consume_credentials()
    if msg.method == REGISTER {
        // The Contact is stored as the phone sent it (its 200 must list
        // it); the registrar keeps the source address as `received` and
        // calls go there. The branch flag marks the binding as NATed.
        if msg.is(NATED) {
            kamailio.call("setbflag", features.nat_bflag)
        }
        location.save()
    }
    // The callee must reach the caller at its real address.
    if msg.is(NATED) {
        nat.fix_contact()
    }
    route_set.record()
    guard location.lookup() else reply(NotFound, "Not registered")
    relay(msg)
}

// A callee behind NAT answers with its private Contact: the caller must
// send the ACK and BYE to the address the reply came from.
on reply(r: Reply) where nat.is_behind(1) {
    nat.fix_contact()
}
