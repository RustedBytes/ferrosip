// A proxy whose per-user state lives in Redis, shared with its twin:
// a block list (callee → blocked callers, with an expiry) and a call
// counter per caller (a window with an expiry).
import ip, redis, route_set
import { features } from config

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    guard ip.in_subnet(msg.src.ip, features.trusted) else reply(Forbidden, "Not trusted")
    // A retransmission must not count as a second call: tm answers it.
    if txn.is_retransmission() {
        txn.exists()
        exit
    }
    if msg.has_to_tag {
        guard route_set.follow() else reply(NotFound, "Not here")
        relay(msg)
    }
    if msg.method == CANCEL {
        relay(msg)
    }
    if msg.method == MESSAGE && (msg.ruri.user == "block" || msg.ruri.user == "unblock") {
        return block_list(msg)
    }
    guard msg.method == INVITE else reply(MethodNotAllowed)
    call(msg)
}

// MESSAGE sip:block@… / sip:unblock@… with `X-Block-User: <caller>`: the
// From user blocks (or unblocks) that caller, for `Expires` seconds
// (default features.block_ttl). Writes fail closed: without Redis the
// user is told the block wasn't stored.
fn block_list(msg: Request) -> Action {
    let target = msg.headers["X-Block-User"]
    guard target =~ "^[A-Za-z0-9._+-]+$" else reply(BadRequest, "Bad X-Block-User")
    let key = "block:{msg.from.user}:{target}"
    if msg.ruri.user == "unblock" {
        guard redis.exec_with("state", "DEL %s", key, "w") else reply(ServiceUnavailable, "Block list unavailable")
        redis.free("w")
        reply(OK, "Unblocked")
    }
    let ttl = "{features.block_ttl}"
    if msg.headers.has("Expires") {
        ttl = msg.headers["Expires"]
    }
    guard ttl =~ "^[1-9][0-9]\{0,7\}$" else reply(BadRequest, "Bad Expires")
    // %s takes each value as one whole token: a value can't add arguments.
    guard redis.exec_with2("state", "SET %s 1 EX %s", key, ttl, "w") else reply(ServiceUnavailable, "Block list unavailable")
    redis.free("w")
    reply(OK, "Blocked")
}

// An INVITE: refused when the callee blocked the caller, or when the
// caller has made call_limit calls in the window. Reads fail open: without
// Redis the call goes through unchecked (logged).
fn call(msg: Request) -> Action {
    if redis.exec_with("state", "EXISTS %s", "block:{msg.ruri.user}:{msg.from.user}", "b") {
        let blocked = pv("$redis(b=>value)")
        redis.free("b")
        if blocked == 1 {
            reply(Decline, "Blocked by callee")
        }
    } else {
        log.warn("redis down: block list not checked for {msg.call_id}\n")
    }
    let key = "calls:{msg.from.user}"
    if redis.exec_with("state", "INCR %s", key, "c") {
        let n = pv("$redis(c=>value)")
        redis.free("c")
        if n == 1 {
            // The first call of a window starts its expiry.
            redis.exec_with2("state", "EXPIRE %s %s", key, "{features.call_window}", "e")
            redis.free("e")
        }
        if n > features.call_limit {
            reply(Forbidden, "Call limit reached")
        }
    } else {
        log.warn("redis down: call counter not checked for {msg.call_id}\n")
    }
    route_set.record()
    msg.headers["X-Served-By"] = features.name
    msg.dst_uri = features.callee
    relay(msg)
}
