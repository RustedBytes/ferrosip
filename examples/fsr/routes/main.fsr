// Routing only: modules and their parameters are in ../ferrosip.toml.
// The modules these functions belong to load by themselves.
// The proxy of examples/toml/routes/main.cfg, plus voicemail on busy or
// no answer, and numbers sent to PSTN gateways with failover (pstn.fsr).

import location, route_set, dialog, limits, nat
import { features } from config
import "./pstn.fsr" as pstn

flag NATED

shared table hits: Map<Str, Counter> ttl 10s
shared table bans: Map<Str, Bool> ttl 10m
shared table stats: Map<Str, Counter>
dialog var caller: Str

route main(msg: Request) {
    guard msg.max_forwards > 0 else reply(TooManyHops)
    guard limits.check_flood() else drop
    if bans.contains(msg.src.ip) {
        drop
    }

    if features.nat && nat.is_behind(msg) {
        msg.set(NATED)
        nat.fix_contact(msg)
    }

    if msg.has_to_tag {
        return in_dialog(msg)
    }

    match msg.method {
        REGISTER => register(msg)
        OPTIONS => reply(OK)
        CANCEL | ACK => {
            if txn.exists() {
                relay(msg)
            }
            drop
        }
        _ => call(msg)
    }
}

fn register(msg: Request) -> Action {
    // More than 20 REGISTERs in 10s from one address: banned for 10 minutes.
    if hits.incr(msg.src.ip) > 20 {
        bans.set(msg.src.ip, true)
        log.warn("banned {msg.src.ip}: REGISTER flood\n")
        drop
    }
    stats.incr("registers")
    location.save(msg)
}

fn in_dialog(msg: Request) -> Action {
    if route_set.follow() {
        relay(msg)
    }
    if msg.method == ACK && txn.exists() {
        relay(msg)
    }
    drop
}

fn call(msg: Request) -> Action {
    if msg.ruri.user =~ "^\\+?[0-9]\{7,\}$" {
        pstn.send(msg)
    }
    guard location.lookup() else reply(NotFound)
    if msg.method != INVITE {
        relay(msg)
    }

    route_set.record()
    dialog.manage()
    dialog.set_profile("calls")
    dialog.caller = msg.from.user

    // The transaction's result is a value: no separate failure_route.
    let res = await txn.relay(msg, timeout: 30s)
    match res {
        Final(r) if r.code in 200..299 => forward(r)
        Final(r) if r.code == BusyHere || r.code == RequestTimeout => voicemail(msg)
        Timeout => voicemail(msg)
        Final(r) => forward(r)
    }
}

fn voicemail(msg: Request) -> Action {
    msg.ruri = features.voicemail
    relay(msg)
}

on reply(r: Reply) where r.code in Ringing..SessionProgress {
    log.info("ringing: {r.call_id}\n")
}

on dialog.ended(d: Dialog) {
    log.info("cdr {d.call_id} caller={d.caller} {d.duration}s {d.end_reason}\n")
}

// GET /api/bans?<ip>, DELETE /api/bans?<ip> (needs [modules.http] listen).
on http(req: HttpRequest) where req.path == "/api/bans" {
    if req.method == "DELETE" {
        bans.remove(req.query)
        req.reply(204)
    }
    if bans.contains(req.query) {
        req.reply(200, "banned\n")
    }
    req.reply(404, "not banned\n")
}

on timer(every: 1m) {
    log.info("{stats.get("registers")} REGISTERs in the last minute\n")
    stats.remove("registers")
}
